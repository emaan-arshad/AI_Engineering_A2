# Copy to .env and fill in. NEVER commit the real .env.

# Shown in the always-visible banner (REQUIRED in the demo recording)
STUDENT_NAME=Your Full Name
STUDENT_ROLL=Your Roll Number

# =====================================================================
# MODE A - local open-source models via Ollama (FREE, no API key)
# =====================================================================
# Leave OLLAMA_MODELS empty to use OpenRouter instead (mode B below).
# Format: tag=category, comma separated. category is `decision` or `llm`.
# The tags must match models you have actually pulled - check with: ollama list
OLLAMA_MODELS=clef=decision,qwen3:8b=llm,deepseek-r1:8b=llm,gemma3:4b=llm
OLLAMA_URL=http://localhost:11434
# Context window. Must be big enough for the cube state (~1200 tokens) or Ollama
# silently truncates the prompt and the model sees a broken cube.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
# Thinking models (deepseek-r1, qwen3): leave empty for the model default,
# or set 0 to switch thinking off and run much faster.
OLLAMA_THINK=

# =====================================================================
# MODE B - OpenRouter (costs money; needs a key with credit)
# =====================================================================
OPENROUTER_API_KEY=
APP_URL=http://localhost:8000
OPUS_MAX_TOKENS=2048
# Let Opus think before answering (low|medium|high). Empty = off. Costs much more per move.
OPUS_REASONING_EFFORT=

# --- Applies to both modes ---
# 1 (default) = every model also sees the cube after each of the 18 possible moves. 0 = off.
SHOW_OUTCOMES=1
